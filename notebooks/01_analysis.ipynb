   "metadata": {},
   "source": [
    "## 3. Research question 1 — predicting star ratings (linear regression)\n",
    "\n",
    "Iteration 1 benchmark on the general 15k sample: **R² = 0.25, MSE = 0.42** using\n",
    "HuggingFace-derived sentiment. Can lexicon features on industry-specific data match that?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "25e5af1e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-17T05:52:07.207441Z",
     "iopub.status.busy": "2026-07-17T05:52:07.206748Z",
     "iopub.status.idle": "2026-07-17T05:52:10.006130Z",
     "shell.execute_reply": "2026-07-17T05:52:10.005175Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "No features exceeded the VIF threshold - all candidates retained.\n",
      "Final feature set (15): max VIF = 3.34\n",
      "Linear regression (refined):  R2 = 0.612   MSE = 0.965   (~0.98 stars avg error)\n",
      "Iteration 1 benchmark: R2 = 0.25, MSE = 0.42\n"
     ]
    }
   ],
   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import r2_score, mean_squared_error\n",
    "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
    "import statsmodels.api as sm\n",
    "\n",
    "# --- Candidate features -----------------------------------------------------\n",
    "# log1p(word_count): linearizes the long right tail of review lengths.\n",
    "# vad_matched_words is deliberately excluded up front - it is a data-quality\n",
    "# indicator (how many words hit the VAD lexicon), not a construct of interest,\n",
    "# and is definitionally collinear with word count.\n",
    "df['log_word_count'] = np.log1p(df['word_count'])\n",
    "\n",
    "candidate_cols = ['vader_sentiment_score','Valence_avg','Arousal_avg','Dominance_avg',\n",
    "                  'log_word_count','avg_word_len','num_excl','num_caps','negation_count',\n",
    "                  'joy_int_avg','anger_int_avg','sadness_int_avg','disgust_int_avg',\n",
    "                  'trust_int_avg','fear_int_avg']\n",
    "# If the pipeline was run with --transformers, fold those features in too;\n",
    "# the pruning loop below will handle any collinearity they introduce.\n",
    "candidate_cols += [c for c in ['hf_computed_sentiment','hf_sentiment_confidence',\n",
    "                               'hf_emotion_confidence'] if c in df.columns]\n",
    "\n",
    "# --- ADAPTIVE multicollinearity control -------------------------------------\n",
    "# Iteratively drop the highest-VIF feature until all VIFs < 10. This re-runs on\n",
    "# whatever data/features are present, so pipeline choices (new samples, industries,\n",
    "# --transformers columns) are handled automatically rather than by frozen decisions.\n",
    "def prune_by_vif(frame, cols, threshold=10.0):\n",
    "    cols = list(cols)\n",
    "    dropped = []\n",
    "    while True:\n",
    "        Xv = sm.add_constant(frame[cols].fillna(0))\n",
    "        vifs = pd.Series(\n",
    "            [variance_inflation_factor(Xv.values, i) for i in range(1, Xv.shape[1])],\n",
    "            index=cols)\n",
    "        worst = vifs.idxmax()\n",
    "        if vifs[worst] < threshold or len(cols) <= 2:\n",
    "            return cols, dropped, vifs.sort_values(ascending=False)\n",
    "        dropped.append((worst, round(float(vifs[worst]), 1)))\n",
    "        cols.remove(worst)\n",
    "\n",
    "X_cols, dropped, final_vifs = prune_by_vif(df, candidate_cols)\n",
    "if dropped:\n",
    "    print('Auto-dropped for collinearity (feature, VIF at removal):', dropped)\n",
    "else:\n",
    "    print('No features exceeded the VIF threshold - all candidates retained.')\n",
    "print(f'Final feature set ({len(X_cols)}): max VIF = {final_vifs.max():.2f}')\n",
    "\n",
    "# --- Fit --------------------------------------------------------------------\n",
    "X = df[X_cols].fillna(0)\n",
    "y = df['stars']\n",
    "X_tr, X_te, y_tr, y_te = train_test_split(X, y, test_size=0.3, random_state=RANDOM_STATE)\n",
    "lin = LinearRegression().fit(X_tr, y_tr)\n",
    "\n",
    "# Stars are bounded [1, 5]: a continuous prediction like 4.79 is meaningful,\n",
    "# but values outside the scale are not - clip to the valid range.\n",
    "pred = np.clip(lin.predict(X_te), 1, 5)\n",
    "\n",
    "r2, mse = r2_score(y_te, pred), mean_squared_error(y_te, pred)\n",
    "print(f'Linear regression (refined):  R2 = {r2:.3f}   MSE = {mse:.3f}   (~{np.sqrt(mse):.2f} stars avg error)')\n",
    "print(f'Iteration 1 benchmark: R2 = 0.25, MSE = 0.42')"
   ]
  },
