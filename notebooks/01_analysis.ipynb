   "source": [
    "# Quantified checks: VIF (multicollinearity) and Breusch-Pagan (heteroscedasticity)\n",
    "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
    "from statsmodels.stats.diagnostic import het_breuschpagan\n",
    "import statsmodels.api as sm\n",
    "\n",
    "X_diag = sm.add_constant(df[X_cols].fillna(0))\n",
    "vif = pd.Series(\n",
    "    [variance_inflation_factor(X_diag.values, i) for i in range(1, X_diag.shape[1])],\n",
    "    index=X_cols, name='VIF').sort_values(ascending=False)\n",
    "print('VIF (rule of thumb: >10 = problematic, >5 = watch):')\n",
    "print(vif.round(2).to_string())\n",
    "\n",
    "ols = sm.OLS(df['stars'], X_diag).fit()\n",
    "bp_stat, bp_p, _, _ = het_breuschpagan(ols.resid, X_diag)\n",
    "print(f'\\nBreusch-Pagan: LM p-value = {bp_p:.2e}'\n",
    "      f'  -> {\"heteroscedasticity present (expected with an ordinal target); \"\n",
    "             \"use robust SEs for any inference\" if bp_p < 0.05 else \"no significant heteroscedasticity\"}')\n",
    "\n",
    "high_vif = vif[vif > 10]\n",
    "if len(high_vif):\n",
    "    print(f'\\nHigh-VIF features: {list(high_vif.index)} - coefficients for these are '\n",
    "          'unstable individually; predictions are unaffected.')\n",
    "\n",
    "# Heteroscedasticity fix: refit with HC3 robust standard errors.\n",
    "# Coefficients are identical to OLS; only the SEs (and thus p-values) change,\n",
    "# making inference valid despite the unequal variance confirmed above.\n",
    "robust = sm.OLS(df['stars'], X_diag).fit(cov_type='HC3')\n",
    "comparison = pd.DataFrame({\n",
    "    'coef': robust.params[1:],\n",
    "    'SE_classical': ols.bse[1:],\n",
    "    'SE_robust_HC3': robust.bse[1:],\n",
    "}).round(4)\n",
    "print('\\nClassical vs HC3-robust standard errors (coefficients unchanged):')\n",
    "print(comparison.to_string())"
   ]
  },
